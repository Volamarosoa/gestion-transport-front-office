@model IEnumerable<GestionTransport.FrontOffice.Models.Employe.AdresseEmployeModel>
@{
    ViewData["Title"] = "Mes adresses";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-header">
        <h5 class="mb-0"><i class="feather icon-upload"></i> Import CSV des adresses</h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-2">Format attendu: <code>Adresse;Latitude;Longitude;EstPrincipale</code></p>
        <p class="text-muted">Exemple: <code>Lot II A 34 Antananarivo;-18.910743;47.536289;true</code></p>

        <form asp-controller="Compte" asp-action="ImportAdressesCsv" method="post" enctype="multipart/form-data" class="row g-2 align-items-center">
            @Html.AntiForgeryToken()
            <div class="col-md-8">
                <input type="file" name="file" accept=".csv" class="form-control" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="feather icon-upload"></i> Uploader et inserer
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Mes adresses</h5>
        <a asp-controller="Compte" asp-action="MonProfil" class="btn btn-sm btn-outline-primary">
            <i class="feather icon-edit"></i> Gérer mes adresses
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Adresse</th>
                        <th>Coordonnées</th>
                        <th>Date d'ajout</th>
                        <th>Statut</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Aucune adresse enregistrée.</td>
                    </tr>
                }
                else
                {
                    foreach (var adresse in Model)
                    {
                        var isPrincipale = adresse.EstPrincipale;
                        <tr class="@(isPrincipale ? "table-success" : string.Empty)" style="@(isPrincipale ? "border-left:4px solid #dc3545;" : string.Empty)">
                            <td>@adresse.Id</td>
                            <td>@adresse.Adresse</td>
                            <td>
                                @if (adresse.Latitude.HasValue && adresse.Longitude.HasValue)
                                {
                                    <span class="text-muted">@adresse.Latitude, @adresse.Longitude</span>
                                }
                                else
                                {
                                    <span class="text-muted">(non renseignées)</span>
                                }
                            </td>
                            <td>@adresse.DateInsertion.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (isPrincipale)
                                {
                                    <span class="badge badge-danger">Adresse actuelle</span>
                                }
                                else
                                {
                                    <span class="badge badge-light">Secondaire</span>
                                }
                            </td>
                            <td>
                                @if (!isPrincipale)
                                {
                                    <form asp-controller="Compte" asp-action="DefinirAdresseActuelle" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@adresse.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            Definir comme actuelle
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

