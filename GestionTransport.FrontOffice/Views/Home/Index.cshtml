@model PaginatedViewModel<AffectationModel>
@{
    ViewData["Title"] = "Tableau de bord";
}

<!-- Statistics Cards - Restent fixes, ne se rechargent pas -->
<div class="row">
    <div class="col-lg-7 col-md-12">
    <!-- support-section start -->
        <div class="row">
            <div class="col-sm-6">
                <div class="card support-bar overflow-hidden">
                    <div class="card-body pb-0">
                        <h2 class="m-0">@ViewBag.TransportsAujourdhui</h2>
                        <span class="text-c-blue">Transports aujourd'hui</span>
                        <p class="mb-3 mt-3">Nombre total de transports effectués aujourd'hui.</p>
                    </div>
                    <div id="support-chart"></div>
                    <div class="card-footer bg-primary text-white">
                        <div class="row text-center">
                            <div class="col">
                                <h4 class="m-0 text-white">@ViewBag.EnCours</h4>
                                <span>En cours</span>
                            </div>
                            <div class="col">
                                <h4 class="m-0 text-white">@ViewBag.Termines</h4>
                                <span>Terminés</span>
                            </div>
                            <div class="col">
                                <h4 class="m-0 text-white">@ViewBag.Annules</h4>
                                <span>Annulés</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card support-bar overflow-hidden">
                    <div class="card-body pb-0">
                        <h2 class="m-0">350</h2>
                        <span class="text-c-green">Support Requests</span>
                        <p class="mb-3 mt-3">Total number of support requests that come in.</p>
                    </div>
                    <div id="support-chart1"></div>
                    <div class="card-footer bg-success text-white">
                        <div class="row text-center">
                            <div class="col">
                                <h4 class="m-0 text-white">10</h4>
                                <span>Open</span>
                            </div>
                            <div class="col">
                                <h4 class="m-0 text-white">5</h4>
                                <span>Running</span>
                            </div>
                            <div class="col">
                                <h4 class="m-0 text-white">3</h4>
                                <span>Solved</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- support-section end -->
    </div>
    <div class="col-lg-5 col-md-12">
        <!-- page statustic card start -->
        <div class="row">
            <div class="col-sm-6">
                <div class="card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-8">
                                <h4 class="text-c-yellow">@ViewBag.ClientsActifs</h4>
                                <h6 class="text-muted m-b-0">Employés actifs</h6>
                            </div>
                            <div class="col-4 text-right">
                                <i class="feather icon-users f-28"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-c-yellow">
                        <div class="row align-items-center">
                            <div class="col-9">
                                <p class="text-white m-b-0">Ce mois</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-8">
                                <h4 class="text-c-green">@(Model.TotalItems - ViewBag.Annules)</h4>
                                <h6 class="text-muted m-b-0">Affectations validées</h6>
                            </div>
                            <div class="col-4 text-right">
                                <i class="feather icon-check-circle f-28"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-c-green">
                        <div class="row align-items-center">
                            <div class="col-9">
                                <p class="text-white m-b-0">Total</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-8">
                                <h4 class="text-c-red">@ViewBag.EnAttente</h4>
                                <h6 class="text-muted m-b-0">En attente</h6>
                            </div>
                            <div class="col-4 text-right">
                                <i class="feather icon-clock f-28"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-c-red">
                        <div class="row align-items-center">
                            <div class="col-9">
                                <p class="text-white m-b-0">À traiter</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-8">
                                <h4 class="text-c-blue">500</h4>
                                <h6 class="text-muted m-b-0">Downloads</h6>
                            </div>
                            <div class="col-4 text-right">
                                <i class="feather icon-thumbs-down f-28"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-c-blue">
                        <div class="row align-items-center">
                            <div class="col-9">
                                <p class="text-white m-b-0">% change</p>
                            </div>
                            <div class="col-3 text-right">
                                <i class="feather icon-trending-down text-white f-16"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- page statustic card end -->
    </div>
</div>

<!-- Table Container avec AJAX automatique -->
<!-- Important: ajouter la classe "ajax-table-container" et data-action-url -->
<div class="row">
    <div class="col-12">
        <div class="ajax-table-container" data-action-url="@Url.Action("Index", "Home")">
            @await Html.PartialAsync("../Partial/_TableauAffectations", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <script>
        // Fonction générique pour capturer et générer le PDF
        async function captureToPDF(element, filename) {
            // Cacher les boutons avant la capture
            const cardHeaderRight = element.querySelector('.card-header-right');
            const originalDisplay = cardHeaderRight ? cardHeaderRight.style.display : '';
            if (cardHeaderRight) {
                cardHeaderRight.style.display = 'none';
            }

            try {
                const canvas = await html2canvas(element, {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    backgroundColor: '#ffffff'
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({
                    orientation: 'landscape',
                    unit: 'mm',
                    format: 'a4'
                });

                const imgData = canvas.toDataURL('image/png');
                const imgWidth = 297;
                const pageHeight = 210;
                const imgHeight = (canvas.height * imgWidth) / canvas.width;
                
                let heightLeft = imgHeight;
                let position = 0;

                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;

                while (heightLeft > 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;
                }

                pdf.save(filename);
            } finally {
                // Restaurer l'affichage
                if (cardHeaderRight) {
                    cardHeaderRight.style.display = originalDisplay;
                }
            }
        }

        // Exporter la page courante
        async function exportCurrentPageToPDF() {
            const element = document.querySelector('.table-card');
            const timestamp = new Date().toISOString().slice(0,19).replace(/[:T]/g, '-');
            await captureToPDF(element, `Affectations_Page_${timestamp}.pdf`);
        }

        // Exporter toutes les affectations
        async function exportAllToPDF() {
            // Afficher un message de chargement
            const loadingDiv = document.createElement('div');
            loadingDiv.id = 'pdf-loading';
            loadingDiv.innerHTML = `
                <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 9999; display: flex; align-items: center; justify-content: center;">
                    <div style="background: white; padding: 30px; border-radius: 10px; text-align: center;">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <h5>Génération du PDF complet en cours...</h5>
                        <p class="text-muted">Cela peut prendre quelques secondes</p>
                    </div>
                </div>
            `;
            document.body.appendChild(loadingDiv);

            try {
                // Charger toutes les données dans une iframe cachée
                const iframe = document.createElement('iframe');
                iframe.style.position = 'absolute';
                iframe.style.left = '-9999px';
                iframe.style.width = '1200px';
                iframe.style.height = '800px';
                document.body.appendChild(iframe);

                // Charger la page avec toutes les données
                iframe.src = '@Url.Action("ExportAllView", "Home")';

                // Attendre le chargement
                await new Promise((resolve) => {
                    iframe.onload = resolve;
                });

                // Attendre un peu pour le rendu
                await new Promise(resolve => setTimeout(resolve, 1500));

                // Capturer et générer le PDF
                const element = iframe.contentDocument.querySelector('.table-card');
                const timestamp = new Date().toISOString().slice(0,19).replace(/[:T]/g, '-');
                await captureToPDF(element, `Affectations_Completes_${timestamp}.pdf`);

                // Nettoyer
                document.body.removeChild(iframe);
            } catch (error) {
                console.error('Erreur:', error);
                alert('Erreur lors de la génération du PDF complet.');
            } finally {
                // Retirer le loading
                document.body.removeChild(loadingDiv);
            }
        }
    </script>
}