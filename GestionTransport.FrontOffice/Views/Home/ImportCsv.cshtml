@{
    ViewData["Title"] = "Import CSV";
}

<div class="row">
    <div class="col-xl-8 offset-xl-2">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5><i class="feather icon-upload"></i> Importer des données depuis un CSV</h5>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="feather icon-alert-circle"></i> @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert">&times;</button>
                    </div>
                }

                <div class="text-center mb-4">
                    <i class="feather icon-file-text" style="font-size: 64px; color: #28a745;"></i>
                    <h4 class="mt-3">Importez n'importe quel fichier CSV</h4>
                    <p class="text-muted">Le système détectera automatiquement les colonnes</p>
                </div>

                <div class="alert alert-info">
                    <h6><i class="feather icon-info"></i> Instructions</h6>
                    <ol class="mb-0">
                        <li>Téléchargez un exemple de CSV pour voir le format</li>
                        <li>Préparez votre fichier CSV (séparateur : <strong>;</strong>)</li>
                        <li>Uploadez votre fichier</li>
                        <li>Associez les colonnes de votre CSV aux champs du système</li>
                    </ol>
                </div>

                <div class="text-center mb-4">
                    <a href="@Url.Action("DownloadCsvTemplate")" class="btn btn-outline-success">
                        <i class="feather icon-download"></i> Télécharger un exemple de CSV
                    </a>
                </div>

                <hr />

                <form method="post" enctype="multipart/form-data" asp-action="AnalyzeCsv">
                    <div class="form-group">
                        <label for="file" class="font-weight-bold">
                            <i class="feather icon-file"></i> Sélectionner votre fichier CSV
                        </label>
                        <div class="custom-file">
                            <input type="file" 
                                   class="custom-file-input" 
                                   id="file" 
                                   name="file" 
                                   accept=".csv"
                                   required
                                   onchange="updateFileName(this)">
                            <label class="custom-file-label" for="file" id="fileLabel">
                                Choisir un fichier CSV...
                            </label>
                        </div>
                        <small class="form-text text-muted">
                            Format : .csv | Séparateur : point-virgule (;) | Encodage : UTF-8
                        </small>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="feather icon-arrow-right"></i> Analyser le fichier
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg ml-2">
                            <i class="feather icon-x"></i> Annuler
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function updateFileName(input) {
        const fileName = input.files[0]?.name || 'Choisir un fichier CSV...';
        document.getElementById('fileLabel').textContent = fileName;
    }
</script>