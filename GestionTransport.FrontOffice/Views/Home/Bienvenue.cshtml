@model List<GestionTransport.FrontOffice.Models.Utils.VehiculeJourViewModel>
@{
	Layout = null;
	var vehiculesFilter = ViewBag.VehiculesFilter as List<GestionTransport.FrontOffice.Models.Utils.VehiculeJourViewModel>
		?? new List<GestionTransport.FrontOffice.Models.Utils.VehiculeJourViewModel>();
	int? selectedVehiculeId = ViewBag.SelectedVehiculeId as int?;
}
<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="utf-8" />
	<title>Bienvenue - Liste du jour</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
	<div class="container mt-4">
		<div class="row mb-4">
			<div class="col-12 d-flex justify-content-between align-items-center">
				<h3 class="mb-0">Bienvenue - Transports valides du jour</h3>
				<div>
					<a class="btn btn-primary" href="@Url.Action("DemanderTransport", "Transport")">Demander un transport</a>
					@if (User.Identity?.IsAuthenticated == true)
					{
						<a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">Tableau de bord</a>
					}
				</div>
			</div>
		</div>

		<div class="row mb-3">
			<div class="col-12">
				<div class="card">
					<div class="card-body py-3">
						<form method="get" asp-action="Bienvenue" asp-controller="Home" class="form-inline">
							<label class="mr-2 font-weight-bold">Filtre avance par vehicule</label>
							<select class="form-control mr-2" name="vehiculeId">
								<option value="">Tous les vehicules</option>
								@foreach (var vehicule in vehiculesFilter)
								{
									if (vehicule.VehiculeId.HasValue)
									{
										if (selectedVehiculeId == vehicule.VehiculeId)
										{
											<option value="@vehicule.VehiculeId" selected>
												@vehicule.VehiculeLabel
											</option>
										}
										else
										{
											<option value="@vehicule.VehiculeId">
												@vehicule.VehiculeLabel
											</option>
										}
									}
								}
							</select>
							<button type="submit" class="btn btn-info mr-2">Appliquer</button>
							<a class="btn btn-outline-secondary" href="@Url.Action("Bienvenue", "Home")">Reinitialiser</a>
						</form>
					</div>
				</div>
			</div>
		</div>

		@if (Model == null || !Model.Any())
		{
			<div class="alert alert-info">Aucune affectation trouvée pour aujourd'hui.</div>
		}
		else
		{
			foreach (var vehicule in Model)
			{
				<div class="card mb-3">
					<div class="card-header d-flex justify-content-between align-items-center">
						<div>
							<strong>@vehicule.VehiculeLabel</strong>
							@if (vehicule.NombrePlaces.HasValue)
							{
								<span class="text-muted">(@vehicule.NombrePlaces places)</span>
							}
						</div>
					</div>
					<div class="card-body p-0">
						<div class="table-responsive">
							<table class="table mb-0">
								<thead class="thead-light">
									<tr>
										<th>Employé</th>
										<th>Matricule</th>
										<th>Adresse</th>
										<th>Site</th>
										<th>Type</th>
										<th>Heure</th>
										<th>Commentaire</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var emp in vehicule.Employes)
									{
										<tr>
											<td>@emp.NomComplet</td>
											<td>@emp.Matricule</td>
											<td>@emp.Adresse</td>
											<td>@emp.Site</td>
											<td>@emp.TypeTransport</td>
											<td>@emp.Heure</td>
											<td>@emp.Commentaire</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			}
		}
	</div>
</body>
</html>

