<header class="navbar pcoded-header navbar-expand-lg navbar-light header-blue">
    <div class="m-header">
        <a class="mobile-menu" id="mobile-collapse" href="#!"><span></span></a>
        <a href="@Url.Action("Index", "Home")" class="b-brand">
            <div class="brand-logo">
                <span class="brand-text">TRANSPORT</span>
            </div>
        </a>
        <a href="#!" class="mob-toggler">
            <i class="feather icon-more-vertical"></i>
        </a>
    </div>
    
    <div class="collapse navbar-collapse">
        <ul class="navbar-nav mr-auto">
            <li class="nav-item">
                <a href="#!" class="pop-search"><i class="feather icon-search"></i></a>
                <div class="search-bar">
                    <input type="text" class="form-control border-0 shadow-none" placeholder="Rechercher une affectation, un employé...">
                    <button type="button" class="close" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            </li>
        </ul>
        
        <ul class="navbar-nav ml-auto">
            
            <!-- User Profile amélioré -->
            <li>
                <div class="dropdown drp-user">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <div class="user-avatar">
                            <i class="feather icon-user"></i>
                        </div>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right profile-notification">
                        <div class="pro-head">
                            <div class="profile-avatar">
                                <i class="feather icon-user"></i>
                            </div>
                            <div class="profile-info">
                                <h6>Jean Dupont</h6>
                                <span class="text-muted">EMP001</span>
                            </div>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dud-logout border-0 bg-transparent" title="Deconnexion">
                                    <i class="feather icon-log-out"></i>
                                </button>
                            </form>
                        </div>
                        <ul class="pro-body">
                            <li>
                                <a asp-controller="Compte" asp-action="MonProfil" class="dropdown-item">
                                    <i class="feather icon-user"></i> Mon Profil
                                </a>
                            </li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger border-0 bg-transparent p-0">
                                        <i class="feather icon-log-out"></i> Deconnexion
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </li>
        </ul>
    </div>
</header>

<style>
    /* Nouveau logo personnalisé */
    .brand-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #fff;
        font-weight: 600;
        font-size: 18px;
    }
    
    .brand-logo i {
        font-size: 24px;
        background: rgba(255, 255, 255, 0.2);
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .brand-text {
        display: inline-block;
    }
    
    /* Avatar utilisateur dans le header */
    .user-avatar {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }
    
    .user-avatar i {
        font-size: 18px;
    }
    
    /* Badge de notification */
    .notification-count {
        position: absolute;
        top: 5px;
        right: 5px;
        font-size: 10px;
        padding: 2px 5px;
    }
    
    /* Icône dans les notifications */
    .notification-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        color: #fff;
    }
    
    .notification.unread {
        background: #f8f9fa;
    }
    
    /* Amélioration du dropdown profil */
    .pro-head {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 15px;
    }
    
    .profile-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(255, 255, 255, 0.5);
    }
    
    .profile-avatar i {
        font-size: 24px;
        color: #fff;
    }
    
    .profile-info {
        flex: 1;
    }
    
    .profile-info h6 {
        color: #fff;
        margin: 0;
        font-weight: 600;
    }
    
    .dud-logout {
        color: #fff;
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }
    
    .dud-logout:hover {
        background: rgba(255, 255, 255, 0.3);
    }
    
    /* Style des items du menu profil */
    .pro-body li a {
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s;
    }
    
    .pro-body li a:hover {
        background: #f8f9fa;
        padding-left: 25px;
    }
    
    .pro-body li a.text-danger:hover {
        background: #fff5f5;
    }
</style>