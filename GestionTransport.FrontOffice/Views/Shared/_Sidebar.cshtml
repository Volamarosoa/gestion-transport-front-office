<nav class="pcoded-navbar menu-light">
    <div class="navbar-wrapper">
        <div class="navbar-content scroll-div">
            
            <!-- User Info -->
            <div class="">
                <div class="main-menu-header">
                    <img class="img-radius" src="~/images/user/avatar-1.jpg" alt="User-Profile-Image">
                    <div class="user-details">
                        <div id="more-details">Employé <i class="fa fa-caret-down"></i></div>
                    </div>
                </div>
            </div>
            
            <!-- Menu Items -->
            <ul class="nav pcoded-inner-navbar">
                <li class="nav-item pcoded-menu-caption">
                    <label>Navigation</label>
                </li>
                
                <!-- Accueil -->
                <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index" class="nav-link">
                        <span class="pcoded-micon"><i class="feather icon-home"></i></span>
                        <span class="pcoded-mtext">Accueil</span>
                    </a>
                </li>
                
                <li class="nav-item pcoded-menu-caption">
                    <label>Demandes de Transport</label>
                </li>
                
                <!-- Mes Transports -->
                <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transport" ? "active" : "")">
                    <a asp-controller="Transport" asp-action="MesTransports" class="nav-link">
                        <span class="pcoded-micon"><i class="feather icon-calendar"></i></span>
                        <span class="pcoded-mtext">Mes transports</span>
                    </a>
                </li>
                
                <!-- Mon transport du jour -->
                <li class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Bienvenue" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Bienvenue" class="nav-link">
                        <span class="pcoded-micon"><i class="feather icon-bell"></i></span>
                        <span class="pcoded-mtext">Mon transport du jour</span>
                    </a>
                </li>
                
                <li class="nav-item pcoded-menu-caption">
                    <label>Mon Circuit</label>
                </li>
                
                <!-- Mon Circuit -->
                <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Circuit" ? "active" : "")">
                    <a asp-controller="Circuit" asp-action="MonCircuit" class="nav-link">
                        <span class="pcoded-micon"><i class="feather icon-map"></i></span>
                        <span class="pcoded-mtext">Mon circuit</span>
                    </a>
                </li>
                
                <!-- Carte Interactive -->
                <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Carte" ? "active" : "")">
                    <a asp-controller="Carte" asp-action="Index" class="nav-link">
                        <span class="pcoded-micon"><i class="feather icon-map-pin"></i></span>
                        <span class="pcoded-mtext">Voir la carte</span>
                    </a>
                </li>
                
                <li class="nav-item pcoded-menu-caption">
                    <label>Mon Compte</label>
                </li>
                
                <!-- Mon Adresse -->
                <li class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Compte" && ViewContext.RouteData.Values["action"]?.ToString() == "MonAdresse" ? "active" : "")">
                    <a asp-controller="Compte" asp-action="MonAdresse" class="nav-link">
                        <span class="pcoded-micon"><i class="feather icon-folder"></i></span>
                        <span class="pcoded-mtext">Mes adresses</span>
                    </a>
                </li>
                
                <!-- Deconnexion -->
                <li class="nav-item">
                    <form id="logoutSidebarForm" asp-controller="Auth" asp-action="Logout" method="post" class="d-none">
                        @Html.AntiForgeryToken()
                    </form>
                    <a href="#" class="nav-link" onclick="document.getElementById('logoutSidebarForm').submit(); return false;">
                        <span class="pcoded-micon"><i class="feather icon-log-out"></i></span>
                        <span class="pcoded-mtext">Deconnexion</span>
                    </a>
                </li>
                
            </ul>
        </div>
    </div>
</nav>
