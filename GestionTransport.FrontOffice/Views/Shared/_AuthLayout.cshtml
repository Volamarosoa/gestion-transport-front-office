<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@ViewData["Title"] - Gestion Transport</title>

    <link rel="icon" href="~/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="~/css/style.css">

    <style>
        body.auth-layout {
            background: #4680ff;
            min-height: 100vh;
        }

        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 16px;
        }

        /* Floating Label Effect */
        .auth-wrapper .form-group {
            position: relative;
            margin-bottom: 20px;
        }

        .auth-wrapper .form-group input {
            padding: 14px 10px 6px;
            height: auto;
        }

        .auth-wrapper .form-group label {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            transition: all 0.2s ease;
            pointer-events: none;
            color: #999;
            font-size: 14px;
            margin: 0;
        }

        /* When focused or has content */
        .auth-wrapper .form-group input:focus + label,
        .auth-wrapper .form-group input:not(:placeholder-shown) + label {
            top: 8px;
            font-size: 11px;
            color: #4680ff;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="auth-layout">
    <main class="auth-shell">
        @RenderBody()
    </main>

    <script src="~/js/vendor-all.min.js"></script>
    <script src="~/js/plugins/bootstrap.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

