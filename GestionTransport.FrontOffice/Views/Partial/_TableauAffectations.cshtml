@model PaginatedViewModel<AffectationModel>

<div class="card table-card">
    <div class="card-header">
        <h5>Dernières affectations</h5>
        <div class="card-header-right d-flex align-items-center">
            <!-- Bouton Export PDF avec JavaScript -->
            <a href="@Url.Action("ImportCsv", "Home")" class="btn btn-success btn-sm mr-2">
                <i class="feather icon-upload"></i> Import CSV
            </a>

            <div class="btn-group mb-2 mr-2">
                <button type="button" class="btn btn-danger dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    Export PDF
                </button>

                <div class="dropdown-menu">
                    <a class="dropdown-item" href="#" onclick="exportCurrentPageToPDF(); return false;">
                        <i class="feather icon-file"></i>
                        Page courante (@Model.Items.Count éléments)
                    </a>
                    <a class="dropdown-item" href="#" onclick="exportAllToPDF(); return false;">
                        <i class="feather icon-list"></i>
                        Toutes les affectations (@Model.TotalItems éléments)
                    </a>
                </div>
            </div>


            <!-- Sélecteur de taille de page -->
            <form method="get" class="d-inline-block mr-2">
                <input type="hidden" name="page" value="1" />
                <select name="pageSize" class="form-control form-control-sm" onchange="this.form.submit()" style="width: auto;">
                    <option value="10" selected="@(Model.PageSize == 10)">10 par page</option>
                    <option value="25" selected="@(Model.PageSize == 25)">25 par page</option>
                    <option value="50" selected="@(Model.PageSize == 50)">50 par page</option>
                </select>
            </form>

            <div class="btn-group card-option">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="feather icon-more-horizontal"></i>
                </button>
                <ul class="list-unstyled card-option dropdown-menu dropdown-menu-right">
                    <li class="dropdown-item full-card"><a href="#!"><span><i class="feather icon-maximize"></i> maximiser</span></a></li>
                    <li class="dropdown-item minimize-card"><a href="#!"><span><i class="feather icon-minus"></i> réduire</span></a></li>
                    <li class="dropdown-item reload-card"><a href="@Url.Action("Index")"><i class="feather icon-refresh-cw"></i> recharger</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <!-- Info pagination en haut -->
        <div class="p-3 border-bottom bg-light">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <p class="mb-0 text-muted">
                        Affichage de <strong>@Model.StartItem</strong> à <strong>@Model.EndItem</strong> 
                        sur <strong>@Model.TotalItems</strong> affectations
                    </p>
                </div>
                <div class="col-sm-6 text-right">
                    <span class="badge badge-primary">Page @Model.CurrentPage sur @Model.TotalPages</span>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="thead-light">
                    <tr>
                        <th>#</th>
                        <th>Employé</th>
                        <th>Site / Adresse</th>
                        <th>Date & Heure</th>
                        <th>Type</th>
                        <th>Véhicule</th>
                        <th>Statut</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var affectation in Model.Items)
                    {
                        var statutInfo = affectation.GetStatut();
                        var statutColor = affectation.EstValidee == true ? "success" : 
                                            affectation.EstValidee == false ? "danger" : "warning";
                        
                        <tr>
                            <td><strong>#@affectation.Id.ToString("D3")</strong></td>
                            <td>
                                <div class="d-inline-block align-middle">
                                    <div class="d-inline-block">
                                        <h6 class="mb-0">@affectation.Employe?.NomComplet()</h6>
                                        <p class="text-muted m-b-0 small">@affectation.Employe?.Matricule</p>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <strong>@affectation.Site?.Nom</strong><br />
                                <small class="text-muted">@affectation.Adresse?.Adresse</small>
                            </td>
                            <td>
                                <div>@affectation.DateTransport?.FormatDate()</div>
                                <small class="text-primary"><i class="feather icon-clock"></i> @affectation.HeureTransport?.FormatHeure() - @affectation.HeureTransport?.Libelle</small>
                            </td>
                            <td>
                                <span class="badge badge-light-@(affectation.TypeTransport?.EstAller() == true ? "info" : "secondary")">
                                    <i class="feather icon-@(affectation.TypeTransport?.EstAller() == true ? "arrow-right" : "arrow-left")"></i>
                                    @affectation.TypeTransport?.Libelle
                                </span>
                            </td>
                            <td>
                                @if (affectation.Vehicule != null)
                                {
                                    <span class="badge badge-light-primary">@affectation.Vehicule.Matricule</span><br />
                                    <small class="text-muted"><i class="feather icon-users"></i> @affectation.Vehicule.NombrePlaces places</small>
                                }
                                else
                                {
                                    <span class="text-muted"><i>Non affecté</i></span>
                                }
                            </td>
                            <td>
                                <label class="badge badge-@statutColor">@statutInfo</label>
                                @if (affectation.EstArchive)
                                {
                                    <br /><small class="text-muted"><i class="feather icon-archive"></i> Archivé</small>
                                }
                            </td>
                            <td class="text-center">
                                <a href="#!" class="btn btn-sm btn-icon btn-primary" title="Voir détails">
                                    <i class="feather icon-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="p-3 border-top bg-light">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-end mb-0">
                    <!-- Bouton Previous -->
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" 
                            href="@(!Model.HasPreviousPage ? "#" : Url.Action("Index", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize }))" 
                            aria-label="Previous">
                            <span aria-hidden="true">&laquo; Précédent</span>
                        </a>
                    </li>

                    <!-- Première page si nécessaire -->
                    @if (Model.GetPageNumbers().First() > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize = Model.PageSize })">1</a>
                        </li>
                        @if (Model.GetPageNumbers().First() > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    <!-- Numéros de page -->
                    @foreach (var pageNumber in Model.GetPageNumbers())
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = pageNumber, pageSize = Model.PageSize })">
                                @pageNumber
                            </a>
                        </li>
                    }

                    <!-- Dernière page si nécessaire -->
                    @if (Model.GetPageNumbers().Last() < Model.TotalPages)
                    {
                        @if (Model.GetPageNumbers().Last() < Model.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = Model.TotalPages, pageSize = Model.PageSize })">@Model.TotalPages</a>
                        </li>
                    }

                    <!-- Bouton Next -->
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" 
                            href="@(!Model.HasNextPage ? "#" : Url.Action("Index", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize }))" 
                            aria-label="Next">
                            <span aria-hidden="true">Suivant &raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Scripts pour l'export PDF -->
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <script>

        async function exportToPDF() {
            // Afficher un loader sur le bouton
            const btn = document.getElementById('exportPdfBtn');
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="feather icon-loader"></i> Génération...';
            btn.disabled = true;

            try {
                // Sélectionner la carte du tableau
                const element = document.querySelector('.table-card');
                
                // Capturer en image avec html2canvas
                const canvas = await html2canvas(element, {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    backgroundColor: '#ffffff'
                });

                // Créer le PDF
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({
                    orientation: 'landscape',
                    unit: 'mm',
                    format: 'a4'
                });

                const imgData = canvas.toDataURL('image/png');
                const imgWidth = 297; // A4 landscape width in mm
                const pageHeight = 210; // A4 height in mm
                const imgHeight = (canvas.height * imgWidth) / canvas.width;
                
                let heightLeft = imgHeight;
                let position = 0;

                // Première page
                pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                heightLeft -= pageHeight;

                // Ajouter des pages supplémentaires si nécessaire
                while (heightLeft > 0) {
                    position = heightLeft - imgHeight;
                    pdf.addPage();
                    pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
                    heightLeft -= pageHeight;
                }

                // Sauvegarder le fichier
                const timestamp = new Date().toISOString().slice(0,19).replace(/[:T]/g, '-');
                const filename = `Affectations_${timestamp}.pdf`;
                pdf.save(filename);

                // Message de succès
                console.log('PDF généré avec succès !');

            } catch (error) {
                console.error('Erreur lors de la génération du PDF:', error);
                alert('Erreur lors de la génération du PDF. Vérifiez la console pour plus de détails.');
            } finally {
                // Restaurer le bouton
                btn.innerHTML = originalHTML;
                btn.disabled = false;
            }
        }
    </script>
}