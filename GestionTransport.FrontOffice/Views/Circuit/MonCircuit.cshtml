@model GestionTransport.FrontOffice.Models.Utils.CircuitJourViewModel
@{
    ViewData["Title"] = "Mon circuit aujourd'hui";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">Circuit du @Model.Date.ToString("dd/MM/yyyy")</h5>
                    <small class="text-muted">Affichage des personnes validees dans le(s) meme(s) vehicule(s), triees du plus proche site au plus loin.</small>
                </div>
                <span class="badge badge-primary">@Model.Vehicules.Count vehicule(s)</span>
            </div>
        </div>
    </div>
</div>

@if (!Model.Vehicules.Any())
{
    <div class="alert alert-info">
        Aucun circuit valide aujourd'hui pour votre vehicule.
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Carte du circuit</h5>
                </div>
                <div class="card-body p-0">
                    <div id="circuitMap" style="height: 620px;"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            @foreach (var vehicule in Model.Vehicules)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@vehicule.VehiculeLabel</strong>
                        <span class="badge badge-info">@vehicule.Personnes.Count pers.</span>
                    </div>
                    <div class="card-body p-2">
                        <div class="mb-2">
                            <small class="text-muted">Site: @vehicule.Site?.Nom</small>
                        </div>
                        <ol class="mb-0 pl-3">
                            @foreach (var p in vehicule.Personnes)
                            {
                                <li class="mb-2">
                                    <div><strong>@p.NomComplet</strong> <small class="text-muted">(@p.Matricule)</small></div>
                                    <div><small>@p.Adresse</small></div>
                                    <div>
                                        <small class="text-muted">
                                            Distance site: @(p.DistanceKmVersSite.HasValue ? p.DistanceKmVersSite.Value.ToString("0.00") + " km" : "N/A")
                                            @if (!string.IsNullOrWhiteSpace(p.Heure))
                                            {
                                                @: | Heure: @p.Heure
                                            }
                                        </small>
                                    </div>
                                </li>
                            }
                        </ol>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script>
        (function () {
            const vehicules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Vehicules));
            if (!vehicules || vehicules.length === 0) {
                return;
            }

            const map = L.map('circuitMap').setView([-18.8792, 47.5079], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            const routeColor = '#e83e8c';
            const bounds = [];

            vehicules.forEach((vehicule, index) => {
                const persons = (vehicule.Personnes || []).filter(p => p.Latitude && p.Longitude);
                const site = vehicule.Site;

                if (site && site.Latitude && site.Longitude) {
                    const siteLatLng = [site.Latitude, site.Longitude];
                    bounds.push(siteLatLng);
                    L.circleMarker(siteLatLng, {
                        radius: 8,
                        color: routeColor,
                        fillColor: routeColor,
                        fillOpacity: 0.9
                    }).addTo(map).bindPopup(`<b>${vehicule.VehiculeLabel}</b><br/>Site: ${site.Nom || ''}`);

                    const linePoints = [siteLatLng];
                    persons.forEach((p, idx) => {
                        const personLatLng = [p.Latitude, p.Longitude];
                        bounds.push(personLatLng);
                        linePoints.push(personLatLng);

                        L.marker(personLatLng)
                            .addTo(map)
                            .bindPopup(
                                `<b>${idx + 1}. ${p.NomComplet || ''}</b><br/>${p.Adresse || ''}<br/>Distance: ${p.DistanceKmVersSite != null ? Number(p.DistanceKmVersSite).toFixed(2) + ' km' : 'N/A'}`
                            )
                            .bindTooltip(`${idx + 1}. ${p.NomComplet || ''}`, {
                                permanent: true,
                                direction: 'top',
                                offset: [0, -8],
                                className: 'bg-white border rounded px-2 py-1'
                            });
                    });

                    if (linePoints.length > 1) {
                        L.polyline(linePoints, {
                            color: routeColor,
                            weight: 4,
                            opacity: 0.8
                        }).addTo(map);
                    }
                }
            });

            if (bounds.length > 0) {
                map.fitBounds(bounds, { padding: [30, 30] });
            }
        })();
    </script>
}

