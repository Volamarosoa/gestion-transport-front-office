@model GestionTransport.FrontOffice.Models.Auth.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<section class="auth-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card auth-card">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h4 class="mb-1">Connexion</h4>
                            <p class="text-muted mb-0">Créez votre compte employé</p>
                        </div>
                        <form asp-action="Login" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            @if (TempData["Info"] != null)
                            {
                                <div class="alert alert-info" role="alert">@TempData["Info"]</div>
                            }
                            @if (TempData["ResetToken"] != null)
                            {
                                <div class="alert alert-warning" role="alert">
                                    Token de reinitialisation: <strong>@TempData["ResetToken"]</strong>
                                </div>
                            }
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            <div class="form-group mb-3 floating-group">
                                <input asp-for="Matricule" class="form-control" placeholder="EMP001" />
                                <label asp-for="Matricule" class="fw-semibold floating-label">Matricule</label>
                                <span asp-validation-for="Matricule" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3 floating-group">
                                <input asp-for="MotDePasse" class="form-control" type="password" placeholder="password123" />
                                <label asp-for="MotDePasse" class="fw-semibold floating-label"> Mot de passe</label>
                                <span asp-validation-for="MotDePasse" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-block btn-primary mb-4">Se connecter</button>
                            <p class="mb-2 text-muted text-center">Mot de passe oublié? <a href="@Url.Action("ForgotPassword", "Auth")" class="f-w-400">Réinitialiser</a></p>
                            <p class="mb-2 text-muted text-center">Pas de compte? <a href="@Url.Action("Register", "Auth")" class="f-w-400">S'inscrire</a></p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

