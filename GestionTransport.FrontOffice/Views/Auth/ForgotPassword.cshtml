@model GestionTransport.FrontOffice.Models.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Réinitialiser le mot de passe</div>
            <div class="card-body">
                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label for="Matricule">Matricule</label>
                        <input asp-for="Matricule" class="form-control" placeholder="EMP001" />
                    </div>
                    <div class="form-group">
                        <label for="Email">Email</label>
                        <input asp-for="Email" class="form-control" type="email" />
                    </div>
                    <p class="text-muted">Renseignez votre matricule ou votre email. Un token de reinitialisation sera genere.</p>
                    <button type="submit" class="btn btn-primary">Envoyer le lien</button>
                    <a class="btn btn-link" href="@Url.Action("Login", "Auth")">Retour connexion</a>
                </form>
            </div>
        </div>
    </div>
</div>
