@model GestionTransport.FrontOffice.Models.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<section class="auth-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card auth-card">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h4 class="mb-1">Inscription</h4>
                            <p class="text-muted mb-0">Créez votre compte employé</p>
                        </div>
                        <form asp-action="Register" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            <div class="form-group mb-3 floating-group">
                                <input asp-for="Matricule" class="form-control" placeholder=" " />
                                <label asp-for="Matricule" class="fw-semibold floating-label">Matricule</label>
                                <span asp-validation-for="Matricule" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3 floating-group">
                                <input asp-for="Email" class="form-control" type="email" placeholder=" " />
                                <label asp-for="Email" class="fw-semibold floating-label">Email</label>
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3 floating-group">
                                <input asp-for="MotDePasse" class="form-control" type="password" placeholder="" />
                                <label asp-for="MotDePasse" class="fw-semibold floating-label"> Mot de passe</label>
                                <span asp-validation-for="MotDePasse" class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3 floating-group">
                                <input asp-for="ConfirmationMotDePasse" class="form-control" type="password" placeholder="" />
                                <label asp-for="ConfirmationMotDePasse" class="fw-semibold floating-label"> Confirmation de mot de passe</label>
                                <span asp-validation-for="ConfirmationMotDePasse" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-block btn-primary mb-4">Créer mon compte</button>
                            <p class="mb-2 text-muted text-center">Mot de passe oublié? <a href="@Url.Action("Login", "Auth")" class="f-w-400">Se connecter</a></p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
