@model GestionTransport.FrontOffice.Models.TransportModel
@{
    ViewData["Title"] = "Demander un Transport";
    var adresseParDefaut = ViewBag.AdresseParDefaut as string;
    var todayIso = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <h5>Demander un Transport</h5>
        </div>
        <div class="card-body">
            <form asp-action="DemanderTransport" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="form-group">
                    <label>Date du transport</label>
                    <input asp-for="Date" type="date" min="@todayIso" class="form-control" required />
                    <span asp-validation-for="Date" class="text-danger"></span>
                    <small class="text-muted">La date doit etre egale ou superieure a aujourd'hui.</small>
                </div>

                <div class="form-group">
                    <label>Type de transport</label>
                    <select asp-for="Type" class="form-control" required>
                        <option value="">-- Sélectionner --</option>
                        <option value="Aller">Aller (Domicile → Entreprise)</option>
                        <option value="Retour">Retour (Entreprise → Domicile)</option>
                        <option value="AllerRetour">Aller-Retour</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label>Adresse de depart par defaut</label>
                    <input type="text" class="form-control" value="@(string.IsNullOrWhiteSpace(adresseParDefaut) ? "Aucune adresse par defaut configuree" : adresseParDefaut)" readonly />
                    <small class="text-muted">Par defaut, la demande utilise votre adresse domicile.</small>
                </div>

                <div class="form-group form-check">
                    <input type="checkbox" class="form-check-input" id="changeAdresseDepart" />
                    <label class="form-check-label" for="changeAdresseDepart">Je veux utiliser une autre adresse de depart</label>
                </div>

                <div class="form-group" id="customAdresseDepartContainer" style="display:none;">
                    <label>Nouvelle adresse de départ</label>
                    <input asp-for="AdresseDepart" type="text" class="form-control" placeholder="Saisir la nouvelle adresse" />
                </div>

                <div class="alert alert-info">
                    Le trajet est limite a <strong>Domicile -> Travail</strong> ou <strong>Travail -> Domicile</strong> selon le type choisi.
                    <br />
                    Pour une demande de demain, la reference J-1 est fixee a 15:00.
                </div>

                <div class="form-group">
                    <label>Heure souhaitée</label>
                    <input asp-for="HeureSouhaitee" type="time" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Raison / Commentaire</label>
                    <textarea asp-for="Commentaire" class="form-control" rows="3" placeholder="Ex: Rendez-vous médical, mission..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="feather icon-send"></i> Soumettre la demande
                </button>
                <a asp-action="MesTransports" class="btn btn-secondary">Annuler</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const checkbox = document.getElementById('changeAdresseDepart');
            const container = document.getElementById('customAdresseDepartContainer');
            const input = document.getElementById('AdresseDepart');

            function syncState() {
                const enabled = checkbox.checked;
                container.style.display = enabled ? 'block' : 'none';
                input.disabled = !enabled;
                if (!enabled) {
                    input.value = '';
                }
            }

            checkbox.addEventListener('change', syncState);
            syncState();
        })();
    </script>
}
