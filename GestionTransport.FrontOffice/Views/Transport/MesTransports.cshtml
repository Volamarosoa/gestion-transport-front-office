@model PaginatedViewModel<AffectationModel>
@{
    ViewData["Title"] = "Mes Demandes de Transport";
}

<div class="col-12">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card">
        <div class="card-header">
            <h5>Mes Demandes de Transport</h5>
            <div class="card-header-right">
                <a asp-action="DemanderTransport" class="btn btn-primary btn-sm">
                    <i class="feather icon-plus"></i> Nouvelle demande
                </a>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Heure</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Aucune demande pour le moment.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var affectation in Model.Items)
                            {
                                var statut = affectation.GetStatut();
                                var statutClass = affectation.EstValidee == true ? "success" : affectation.EstValidee == false ? "danger" : "warning";
                                <tr>
                                    <td>@affectation.DateTransport?.ToString("dd/MM/yyyy")</td>
                                    <td>@affectation.TypeTransport?.Libelle</td>
                                    <td>@affectation.HeureTransport?.FormatHeure()</td>
                                    <td><span class="badge badge-@statutClass">@statut</span></td>
                                    <td>
                                        <a asp-action="DetailsTransport" asp-route-id="@affectation.Id" class="btn btn-sm btn-info">Voir</a>
                                        @if (!affectation.EstValidee.HasValue)
                                        {
                                            <form asp-action="AnnulerTransport" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@affectation.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger">Annuler</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-end mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="@(!Model.HasPreviousPage ? "#" : Url.Action("MesTransports", new { page = Model.CurrentPage - 1, pageSize = Model.PageSize }))" aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        @foreach (var p in Model.GetPageNumbers())
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("MesTransports", new { page = p, pageSize = Model.PageSize })">@p</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="@(!Model.HasNextPage ? "#" : Url.Action("MesTransports", new { page = Model.CurrentPage + 1, pageSize = Model.PageSize }))" aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>